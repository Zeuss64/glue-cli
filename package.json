{
  "name": "glue-cli",
  "version": "0.1.106",
  "description": "Glue Cli — Claude Code–style open coding agent CLI",
  "license": "MIT",
  "keywords": [
    "cli",
    "coding-agent",
    "glue",
    "glue-cli",
    "terminal",
    "openai",
    "agent"
  ],
  "homepage": "https://github.com/Zeuss64/glue-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zeuss64/glue-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Zeuss64/glue-cli/issues"
  },
  "type": "module",
  "bin": {
    "glue": "./dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "install:global": "npm run build && node scripts/install-global.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/cli.js",
    "mock": "node scripts/mock-openai.mjs"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^3.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
